# Perfil y puerto (nginx hace proxy desde el 80 a este puerto)
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8081

# Base de datos
DB_HOST=
DB_PORT=5432
DB_NAME=fleet_db
DB_USER=
DB_PASSWORD=

# Kafka (IP privada de la EC2 de Kafka)
KAFKA_BOOTSTRAP=

# Identity (IP privada de su EC2, sin puerto porque pasa por nginx)
IDENTITY_JWKS_URI=http://<IP_PRIVADA_IDENTITY>/.well-known/jwks.json
IDENTITY_URL=http://<IP_PRIVADA_IDENTITY>

# Trip (IP privada de su EC2)
TRIP_SERVICE_URL=http://<IP_PRIVADA_TRIP>

# Clave compartida con identity, customer y trip (debe ser idéntica en todos)
# Generar con: openssl rand -base64 32
INTERNAL_API_KEY=

# S3 (fotos)
S3_BUCKET=bucket-proyecto-final-sa
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=